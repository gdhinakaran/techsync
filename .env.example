# TechSync Configuration

# Secret key for session management (generate a random string for production)
SECRET_KEY=your-secret-key-here

# Database URL (default: SQLite file in project directory)
DATABASE_URL=sqlite:///techsync.db

# LLM Configuration
# Provider options: openai, anthropic, ollama
LLM_PROVIDER=openai

# Your API key for the chosen provider
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Anthropic: Get from https://console.anthropic.com/
# For Ollama: Leave empty (local)
LLM_API_KEY=your-api-key-here

# Model to use
# OpenAI examples: gpt-3.5-turbo, gpt-4
# Anthropic examples: claude-3-haiku-20240307, claude-3-sonnet-20240229
# Ollama examples: llama2, mistral
LLM_MODEL=gpt-3.5-turbo
